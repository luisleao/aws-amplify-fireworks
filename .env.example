# Copie para .env.local (desenvolvimento) ou cole no console do Amplify
# (App settings -> Environment variables) para produção.
#
# Sem nenhuma destas variáveis o app roda em modo local: o backend publica num
# barramento em memória e o telão consome por SSE. Basta `npm run dev`.
#
# Todos os valores saem dos outputs de `npm run deploy` em infra/.

# --- Servidor: publica com SigV4, sem chave ---
EVENTS_HTTP_DOMAIN=
EVENTS_CHANNEL=/default/show
# Opcional: por padrão usa AWS_REGION, que o Amplify já injeta no runtime SSR.
EVENTS_REGION=

# --- Navegador: só conecta e assina ---
# Precisam existir no momento do BUILD — o Next embute NEXT_PUBLIC_* no bundle.
NEXT_PUBLIC_EVENTS_HTTP_DOMAIN=
NEXT_PUBLIC_EVENTS_REALTIME_DOMAIN=
NEXT_PUBLIC_EVENTS_API_KEY=
NEXT_PUBLIC_EVENTS_CHANNEL=/default/show
